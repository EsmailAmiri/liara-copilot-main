# ---------- Modes ----------
# mock = fully offline fake Liara / scripted fake LLM (default for dev & tests)
# live = real APIs (requires the credentials below)
LIARA_MODE=mock
LLM_MODE=mock

# ---------- Liara (OWNER FILLS) ----------
# Create at https://console.liara.ir/API (choose an expiry). Team accounts also need the Team ID.
LIARA_API_TOKEN=
LIARA_API_BASE_URL=https://api.liara.ir
LIARA_TEAM_ID=
# Optional: scope the copilot to specific apps (comma separated). Empty = all apps in the account.
LIARA_APP_ALLOWLIST=

# ---------- LLM (OWNER FILLS) ----------
# Any OpenAI-compatible chat completions endpoint that supports tool/function calling.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Set to 0 if the model does not support native tool calling (enables JSON-action fallback)
LLM_NATIVE_TOOLS=1

# ---------- Server ----------
PORT=3001
DATA_DIR=./data
# Single-user passcode protecting the UI (the app holds infra credentials!)
APP_PASSCODE=change-me
SESSION_SECRET=change-me-long-random
APPROVAL_TTL_SECONDS=600
MONITOR_INTERVAL_SECONDS=60
# Web origin allowed by CORS if web calls the API directly
WEB_ORIGIN=http://localhost:3000

# ---------- Web ----------
# Server-side URL the Next.js proxy uses to reach the API
API_URL=http://localhost:3001

# ---------- Demo app (the intentionally faulty site) ----------
# none | missing_env | memory_leak | wrong_port | db_down
FAULT=none
