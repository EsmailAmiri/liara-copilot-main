{
  "name": "liara-copilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.0",
    "playwright": "^1.64.1",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @copilot/server --filter @copilot/web --filter @copilot/demo-app dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "probe": "pnpm --filter @copilot/liara-client probe",
    "scenario": "pnpm --filter @copilot/server scenario",
    "mcp": "pnpm --filter @copilot/mcp start"
  }
}
